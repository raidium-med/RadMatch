# RadMatch environment variables
#
# Copy this file to `.env` and fill in the credentials for whichever provider(s)
# you plan to use. Then `source .env` before running the CLI.

# --- Azure OpenAI ---
# Required if you pass an Azure-hosted model to --llm-extractor / --llm-judge.
# Set the endpoint URL of your Azure OpenAI resource and the associated API key.
export AZURE_OPENAI_ENDPOINT="https://<your-resource>.cognitiveservices.azure.com/"
export AZURE_OPENAI_API_KEY="<your-azure-openai-api-key>"

# --- Mistral ---
# Required if you pass a Mistral-hosted model (e.g. magistral-medium-2509).
export MISTRAL_API_KEY="<your-mistral-api-key>"
