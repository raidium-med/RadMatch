# Credentials for RadMatch's model providers.
# Copy this file to .env and fill in the ones you need:
#
#   cp env.example .env && source .env
#
# Only the providers you actually address via `--llm-extractor` / `--llm-judge` need
# credentials. `assert_credentials_for` fails fast at startup if a selected model has none.

# --- OpenAI ---------------------------------------------------------------------
# GPT models, plus Kimi and DeepSeek (served over the same OpenAI-compatible route on
# Azure). Set OPENAI_API_KEY to use api.openai.com:
export OPENAI_API_KEY="your-api-key-here"

# ...or point at an Azure OpenAI resource instead. When AZURE_OPENAI_ENDPOINT is set it
# takes precedence, and the model name is then the *deployment* name.
# export AZURE_OPENAI_ENDPOINT="https://<your-resource>.cognitiveservices.azure.com/"
# export AZURE_OPENAI_API_KEY="your-api-key-here"

# --- Anthropic ------------------------------------------------------------------
# Claude models. Set ANTHROPIC_API_KEY to use api.anthropic.com:
export ANTHROPIC_API_KEY="your-api-key-here"

# ...or point at Azure Foundry's Messages API instead. When ANTHROPIC_FOUNDRY_BASE_URL is
# set it takes precedence. Claude is region-locked on Foundry, so it may live on a
# different resource than your GPT deployments.
# export ANTHROPIC_FOUNDRY_BASE_URL="https://<your-resource>.services.ai.azure.com/anthropic"
# export ANTHROPIC_FOUNDRY_API_KEY="your-api-key-here"

# --- Mistral --------------------------------------------------------------------
# export MISTRAL_API_KEY="your-api-key-here"

# --- Self-hosted / local models -------------------------------------------------
# Any OpenAI-compatible endpoint (vLLM, SGLang, Ollama, TGI, ...). Address such models
# with a `local:` prefix, e.g. `--llm-judge local:google/medgemma-1.5-4b-it`. Only the
# base URL is required; most local servers ignore the API key.
# export RADMATCH_LOCAL_BASE_URL="http://localhost:8000/v1"
# export RADMATCH_LOCAL_API_KEY="EMPTY"
